# SOUND Group — Environment Configuration Template
# Copy this file to .env and fill in your values.
# Switch environments by uncommenting one section and commenting the other.
# NEVER have two active values for the same variable at the same time.
# DO NOT commit .env to version control.

# ============================================================
# ACTIVE ENVIRONMENT: LOCAL
# ============================================================

# APP_ENV=local
# APP_NAME=SOUND Group
# APP_DEBUG=false

# # -- Application URL --
# APP_URL=http://localhost/Aptech_E_Project_02/sound_management

# # -- Database --
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sound_management
# DB_USERNAME=root
# DB_PASSWORD=

# ============================================================
# PRODUCTION CONFIGURATION (INFINITYFREE)
# Uncomment these and comment the LOCAL values above when deploying.
# ============================================================

APP_ENV=production
APP_NAME=SOUND Group
APP_DEBUG=false

APP_URL=https://your-production-domain.com

DB_HOST=sql308.infinityfree.com
DB_PORT=3306
DB_DATABASE=if0_42784841_soundgroup
DB_USERNAME=if0_42784841
DB_PASSWORD=your-vpanel-password

# ============================================================
# SHARED CONFIGURATION (same for both environments)
# ============================================================

# -- Mail / SMTP --
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=SOUND Group

# -- OTP Settings --
OTP_LENGTH=6
OTP_EXPIRES_IN=180

# -- Cloudinary --
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
